# Raw Nanopore Datasets (large binary & fastq files)
datasets/
*.fast5
*.pod5
*.fastq
*.fastq.gz
*.fastq*

# Pipeline Output Results
results/
*.sam
*.bam
*.bai
*.paf
*.fasta
*.fasta.fai

# Binary trace data & temporary folded stacks
logs/*.data
logs/*.folded
*.data
*.folded

# Explicitly allow scripts and unpinned baseline telemetry logs
!scripts/
!scripts/**
!logs/
!logs/unpinned_baseline/
!logs/unpinned_baseline/*.csv
!logs/unpinned_baseline/*.json
!logs/unpinned_baseline/*.txt
!logs/unpinned_baseline/*.html

# External / Third-party Cloned Repositories
scripts/FlameGraph/
pipelines/

# Nextflow & Python temporary files
.nextflow*
work/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.swp
*.tmp
